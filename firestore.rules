rules_version = '2';

// Les règles de sécurité du monde de Faelorenn. Ce sont elles qui protègent les données :
// la configuration Firebase est publique (elle est dans le code du site), ces règles ne le sont pas
// moins, mais personne ne peut les contourner.
//
// Étape 1 (le socle) : comptes, invitations, demandes d'entrée et réglages personnels.
// Tout le reste est fermé tant que les registres n'ont pas basculé en ligne.
//
// Déployer : firebase deploy --only firestore:rules   (tests d'abord : cd outils/tests-regles && npm test)

service cloud.firestore {
  match /databases/{db}/documents {

    function connecte() { return request.auth != null; }
    function moi() { return request.auth.uid; }
    function compteDe(uid) { return /databases/$(db)/documents/comptes/$(uid); }
    function invitationDe(code) { return /databases/$(db)/documents/invitations/$(code); }
    // un compte invité, et pas désactivé
    function invite() {
      return connecte() && exists(compteDe(moi())) && get(compteDe(moi())).data.actif == true;
    }
    function admin() { return invite() && get(compteDe(moi())).data.role == 'admin'; }
    function n() { return request.resource.data; }
    function a() { return resource.data; }
    function touche() { return n().diff(a()).affectedKeys(); }
    // un pseudo : du texte, 2 à 30 caractères, sans balise
    function pseudoValable(p) { return p is string && p.size() >= 2 && p.size() <= 30 && !p.matches('.*[<>].*'); }

    // ---------- les invitations ----------
    // Le code est le secret : on peut lire SON invitation (get), pas la liste (list).
    match /invitations/{code} {
      allow get: if connecte();
      allow list: if admin();
      allow create: if admin()
        && n().keys().hasOnly(['role', 'creePar', 'cree', 'expire', 'utilisee', 'email', 'note'])
        && n().role in ['joueur', 'admin'] && n().creePar == moi() && n().cree == request.time
        && n().expire is timestamp && n().expire > request.time && n().utilisee == false
        && (!('email' in n()) || n().email is string)
        && code.size() >= 20;
      // on consomme une invitation en créant son compte, dans le même lot d'écritures
      allow update: if admin() || (
        connecte() && a().utilisee == false && a().expire > request.time
        && touche().hasOnly(['utilisee', 'par', 'le'])
        && n().utilisee == true && n().par == moi() && n().le == request.time
        && existsAfter(compteDe(moi()))
        && getAfter(compteDe(moi())).data.invitation == code);
      allow delete: if admin();
    }

    // ---------- les comptes ----------
    match /comptes/{uid} {
      // tous les invités voient les pseudos et les rôles ; chacun voit toujours son propre compte
      allow read: if invite() || (connecte() && uid == moi());
      allow create: if connecte() && (
        // soi-même, avec une invitation valable, consommée dans le même lot
        (uid == moi()
          && n().keys().hasOnly(['nom', 'role', 'actif', 'invitation', 'cree'])
          && pseudoValable(n().nom) && n().actif == true && n().cree == request.time
          && n().invitation is string
          && exists(invitationDe(n().invitation))
          && get(invitationDe(n().invitation)).data.utilisee == false
          && get(invitationDe(n().invitation)).data.expire > request.time
          && n().role == get(invitationDe(n().invitation)).data.role
          && (!('email' in get(invitationDe(n().invitation)).data)
              || get(invitationDe(n().invitation)).data.email == ''
              || (request.auth.token.email == get(invitationDe(n().invitation)).data.email
                  && request.auth.token.email_verified == true))
          && getAfter(invitationDe(n().invitation)).data.par == moi())
        // ou un admin qui accepte une demande d'entrée
        || (admin()
          && n().keys().hasOnly(['nom', 'role', 'actif', 'invitation', 'cree'])
          && pseudoValable(n().nom) && n().role in ['joueur', 'admin'] && n().actif == true
          && n().cree == request.time));
      allow update: if
        // chacun change son pseudo, rien d'autre
        (uid == moi() && invite() && touche().hasOnly(['nom']) && pseudoValable(n().nom))
        // un admin change le rôle, l'activité ou le pseudo, mais jamais ceux du fondateur
        || (admin() && touche().hasOnly(['nom', 'role', 'actif'])
            && pseudoValable(n().nom) && n().role in ['joueur', 'admin'] && n().actif is bool
            && !(a().get('fondateur', false) == true && uid != moi())
            && !(uid == moi() && touche().hasAny(['role', 'actif'])));
      allow delete: if false;

      // les réglages de chacun (disposition de la table, préférences) : à lui seul
      match /prefs/{cle} {
        allow read, write: if uid == moi() && invite();
      }
    }

    // ---------- les demandes d'entrée ----------
    // un compte connecté mais pas invité demande à entrer ; un admin accepte ou refuse
    match /demandes/{uid} {
      allow create: if connecte() && uid == moi() && !exists(compteDe(uid))
        && n().keys().hasOnly(['nom', 'email', 'cree'])
        && pseudoValable(n().nom) && n().email == request.auth.token.get('email', '') && n().cree == request.time;
      allow read: if admin() || (connecte() && uid == moi());
      allow delete: if admin() || (connecte() && uid == moi());
      allow update: if false;
    }

    // ================= le monde : la table et ce qui l'entoure =================
    // Chaque document : f (la fiche, JSON), e (l'état de jeu, JSON), c (la carte de combat, JSON),
    // proprietaire, proprietaireNom, cree, majS (heure du serveur), modifiePar,
    // et selon la collection campagne, perso, statut, membres. Voir src/js/commun/formes-en-ligne.js.

    function campagneDe(cid) { return /databases/$(db)/documents/campagnes/$(cid); }
    // membre d'une campagne : elle existe et l'a parmi ses membres
    function membreDe(cid) {
      return cid is string && cid != '' && exists(campagneDe(cid)) && moi() in get(campagneDe(cid)).data.membres;
    }
    function aMoi() { return a().proprietaire == moi(); }
    function formeOk() {
      return n().keys().hasOnly(['f', 'e', 'c', 'campagne', 'perso', 'statut', 'membres', 'section',
                                 'proprietaire', 'proprietaireNom', 'cree', 'majS', 'modifiePar'])
        && n().f is string && n().get('e', '') is string && n().get('c', '') is string
        && n().majS == request.time && n().modifiePar == moi()
        && n().proprietaire is string && n().proprietaireNom is string;
    }
    // une création : à son nom (un admin peut créer au nom d'un autre : c'est l'import)
    function creation() {
      return invite() && formeOk() && n().cree == request.time
        && (n().proprietaire == moi() || admin());
    }
    // une modification : le créateur et la date de création ne changent jamais
    function modification() {
      return invite() && formeOk() && !touche().hasAny(['proprietaire', 'proprietaireNom', 'cree']);
    }
    // ne touche que ces champs-là (plus les dates)
    function seulement(champs) { return touche().hasOnly(champs.concat(['majS', 'modifiePar'])); }

    // ---------- les campagnes : chacune a ses membres ----------
    match /campagnes/{cid} {
      allow read: if invite();
      allow create: if creation() && n().membres is list && (n().proprietaire in n().membres);
      allow update: if modification() && n().membres is list && (
        (aMoi() && (moi() in n().membres))                    // son créateur : tout, les membres compris
        || (moi() in a().membres && seulement(['e']))         // un membre : le jour de jeu, la purge des jets
        || admin());
    }

    // ---------- les personnages : la fiche au joueur, l'état de jeu aux membres de sa campagne ----------
    match /personnages/{id} {
      allow read: if invite();
      allow create: if creation();
      allow update: if modification() && (
        aMoi() || (membreDe(a().campagne) && seulement(['e'])) || admin());
    }

    // ---------- ce qui appartient à une campagne : lu par ses seuls membres ----------
    match /seances/{id} {
      allow read: if invite() && (membreDe(resource.data.campagne) || admin());
      allow create: if creation() && (membreDe(n().campagne) || admin());
      allow update: if modification() && (
        (aMoi() && membreDe(n().campagne))
        || (membreDe(a().campagne) && seulement(['e', 'c']))  // les cartes du round, la carte, les jetons, les états
        || admin());
    }
    match /paragraphes/{id} {
      allow read: if invite() && (membreDe(resource.data.campagne) || admin());
      allow create: if creation() && (membreDe(n().campagne) || admin());
      // chacun ses paragraphes
      allow update: if modification() && ((aMoi() && membreDe(n().campagne)) || admin());
    }
    // une rencontre et ses adversaires : tous les membres s'y battent
    match /rencontres/{id} {
      allow read: if invite() && (membreDe(resource.data.campagne) || admin());
      allow create: if creation() && (membreDe(n().campagne) || admin());
      allow update: if modification() && ((membreDe(a().campagne) && membreDe(n().campagne)) || admin());
    }
    match /adversaires/{id} {
      allow read: if invite() && (membreDe(resource.data.campagne) || admin());
      allow create: if creation() && (membreDe(n().campagne) || admin());
      allow update: if modification() && ((membreDe(a().campagne) && membreDe(n().campagne)) || admin());
    }
    // les jets : écrits une fois, jamais retouchés
    match /jets/{id} {
      allow read: if invite() && (membreDe(resource.data.campagne) || admin());
      allow create: if creation() && (membreDe(n().campagne) || admin());
      allow update: if false;
      allow delete: if admin();
    }

    // ---------- le monde commun : lu par tous les invités ----------
    match /pnj/{id} {
      allow read: if invite();
      allow create: if creation();
      // ses PV, ses coups, son entrée en combat : tout le monde ; sa fiche et sa description : son créateur
      allow update: if modification() && (aMoi() || seulement(['e']) || admin());
      // le lore : chacun en ajoute, personne ne réécrit celui des autres
      match /lore/{lid} {
        allow read: if invite();
        allow create: if invite() && n().keys().hasOnly(['texte', 'proprietaire', 'proprietaireNom', 't'])
          && n().proprietaire == moi() && n().proprietaireNom == get(compteDe(moi())).data.nom
          && n().t == request.time && n().texte is string && n().texte.size() > 0 && n().texte.size() <= 4000;
        allow update: if false;
        allow delete: if admin();
      }
    }
    // une mission : son texte à son créateur, où elle en est à tous (la lancer, la boucler)
    match /missions/{id} {
      allow read: if invite();
      allow create: if creation();
      allow update: if modification() && (aMoi() || seulement(['e']) || admin());
    }
    match /lieux/{id} {
      allow read: if invite();
      allow create: if creation();
      allow update: if modification() && (aMoi() || admin());
    }
    match /liens/{id} {
      allow read: if invite();
      allow create: if creation();
      allow update: if modification() && (aMoi() || admin());
    }
    // le sac et la bourse : on peut donner à un autre (une ligne à son nom), seul celui qui l'a écrite
    // ou le joueur du personnage la retouche
    function joueurDe(pid) {
      return pid is string && pid != '' && exists(/databases/$(db)/documents/personnages/$(pid))
        && get(/databases/$(db)/documents/personnages/$(pid)).data.proprietaire == moi();
    }
    match /objets/{id} {
      allow read: if invite();
      allow create: if creation() && n().perso is string;
      allow update: if modification() && n().perso == a().perso && (aMoi() || joueurDe(a().perso) || admin());
    }
    match /argent/{id} {
      allow read: if invite();
      allow create: if creation() && n().perso is string;
      allow update: if modification() && n().perso == a().perso && (aMoi() || joueurDe(a().perso) || admin());
    }

    // ---------- les tables de tirage : privées tant qu'un admin ne les a pas validées ----------
    match /tables/{id} {
      allow read: if invite() && (resource.data.statut == 'valide' || resource.data.proprietaire == moi() || admin());
      allow create: if creation() && (n().statut in ['prive', 'propose'] || (admin() && n().statut == 'valide'));
      // une table validée que son créateur retouche repasse en proposition
      allow update: if modification() && (
        (aMoi() && n().statut in ['prive', 'propose'])
        || admin());
    }

    // ---------- la table elle-même : son nom, la purge des jets, les seuils de l'oracle ----------
    match /monde/{doc} {
      allow read: if invite();
      allow create: if creation() && admin();
      allow update: if modification() && (seulement(['e']) || admin());
    }

    // ---------- les personnages du Havre : à leur joueur, vus de tous ----------
    match /havre/{id} {
      allow read: if invite();
      allow create: if creation();
      allow update: if modification() && (aMoi() || admin());
    }

    // ---------- bestiaire et plans : privés tant qu'un admin ne les a pas validés ----------
    // (même règle que les tables de tirage) une pièce validée que son créateur retouche repasse en proposition
    function lisibleSelonStatut() { return resource.data.statut == 'valide' || resource.data.proprietaire == moi() || admin(); }
    function creationSelonStatut() { return creation() && (n().statut in ['prive', 'propose'] || (admin() && n().statut == 'valide')); }
    function modificationSelonStatut() { return modification() && ((aMoi() && n().statut in ['prive', 'propose']) || admin()); }
    match /creatures/{id} {
      allow read: if invite() && lisibleSelonStatut();
      allow create: if creationSelonStatut();
      allow update: if modificationSelonStatut();
    }
    match /familles/{id} {
      allow read: if invite() && lisibleSelonStatut();
      allow create: if creationSelonStatut();
      allow update: if modificationSelonStatut();
    }
    match /butins/{id} {
      allow read: if invite() && lisibleSelonStatut();
      allow create: if creationSelonStatut();
      allow update: if modificationSelonStatut();
    }
    match /plans/{id} {
      allow read: if invite() && lisibleSelonStatut();
      allow create: if creationSelonStatut() && n().section in ['batiments', 'villages', 'mondes'];
      allow update: if modificationSelonStatut() && n().section == a().section;
    }

    // ---------- les compétences : seuls les admins les changent ----------
    match /regles/{doc} {
      allow read: if invite();
      allow create: if creation() && admin();
      allow update: if modification() && admin();
    }
    // ce qu'un joueur propose de changer, qu'un admin accepte ou refuse
    match /propositions/{id} {
      allow read: if invite() && (resource.data.proprietaire == moi() || admin());
      allow create: if invite() && n().keys().hasOnly(['texte', 'sujet', 'proprietaire', 'proprietaireNom', 't', 'statut'])
        && n().proprietaire == moi() && n().proprietaireNom == get(compteDe(moi())).data.nom
        && n().t == request.time && n().statut == 'ouverte'
        && n().texte is string && n().texte.size() > 0 && n().texte.size() <= 4000
        && n().sujet is string && n().sujet.size() <= 200;
      allow update: if admin() && touche().hasOnly(['statut', 'reponse', 'decidePar', 'decideLe'])
        && n().statut in ['acceptee', 'refusee'] && n().decidePar == moi() && n().decideLe == request.time;
      allow delete: if admin();
    }

    // ---------- tout le reste : fermé ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
